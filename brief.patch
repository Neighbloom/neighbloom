+/* ============================================================
+   THE WORTH BRIEF — Home redesign (felix/home-redesign, 2026-10-13)
+   An editorial, finite daily brief on a warm paper surface inside
+   the navy brand frame. Design rules (BENCHMARK.md): the town is
+   the masthead; hairlines not shadowed cards; post types distinct
+   by structure; one filled button above the fold; every number
+   real and sourced; the empty state is a designed front page.
+   Type: Fraunces (display, self-hosted) + Nunito (UI/body).
+   ============================================================ */
+@font-face {
+  font-family: 'Fraunces';
+  src: url('/fonts/fraunces-600.woff2') format('woff2');
+  font-weight: 600; font-style: normal; font-display: swap;
+}
+@font-face {
+  font-family: 'Fraunces';
+  src: url('/fonts/fraunces-900.woff2') format('woff2');
+  font-weight: 900; font-style: normal; font-display: swap;
+}
+@font-face {
+  font-family: 'Fraunces';
+  src: url('/fonts/fraunces-600-italic.woff2') format('woff2');
+  font-weight: 600; font-style: italic; font-display: swap;
+}
+
+.nb-brief {
+  --paper: #FAF6ED;
+  --paper-deep: #F3ECDB;
+  --ink: #21334B;
+  --ink-soft: rgba(33, 51, 75, 0.66);
+  --ink-faint: rgba(33, 51, 75, 0.52);
+  --rule: rgba(33, 51, 75, 0.18);
+  --rule-strong: rgba(33, 51, 75, 0.85);
+  --coral: #F35B50;
+  --coral-deep: #C93A31;
+  --teal: #1F7A6E;
+  --well: #14243E;
+  background: var(--paper);
+  color: var(--ink);
+  min-height: 100%;
+  padding: 0 20px 40px;
+  font-family: 'Nunito', system-ui, sans-serif;
+  animation: nb-brief-in 160ms ease-out;
+}
+@keyframes nb-brief-in { from { opacity: 0; } to { opacity: 1; } }
+@media (prefers-reduced-motion: reduce) {
+  .nb-brief { animation: none; }
+  .nb-brief-well { transition: none; }
+}
+
+/* — Masthead — */
+.nb-brief-masthead { padding-top: 18px; }
+.nb-brief-plate {
+  border-top: 3px solid var(--rule-strong);
+  border-bottom: 1px solid var(--rule-strong);
+  padding: 8px 0 9px;
+  text-align: center;
+}
+.nb-brief-kicker {
+  font-size: 11px; font-weight: 900; letter-spacing: 0.22em;
+  text-transform: uppercase; color: var(--coral-deep);
+}
+.nb-brief-town {
+  font-family: 'Fraunces', Georgia, serif;
+  font-weight: 900;
+  font-size: 40px; line-height: 1.02; letter-spacing: -0.01em;
+  margin: 2px 0 4px;
+}
+.nb-brief-dateline {
+  font-size: 12.5px; font-weight: 700; color: var(--ink-soft);
+  letter-spacing: 0.04em;
+}
+.nb-brief-status {
+  margin: 10px 0 0; font-size: 15.5px; line-height: 1.5;
+  text-align: center; color: var(--ink);
+}
+.nb-brief-status strong { font-weight: 900; }
+.nb-brief-away {
+  margin-top: 6px; font-size: 12.5px; text-align: center;
+  font-size: 13px; font-weight: 800; color: var(--ink-soft);
+}
+.nb-brief-away button {
+  background: none; border: none; padding: 0; cursor: pointer;
+  font: inherit; color: var(--coral-deep); font-weight: 900;
+  text-decoration: underline; text-underline-offset: 3px;
+}
+
+/* — Primary action row (exactly one filled button) — */
+.nb-brief-actions {
+  display: flex; align-items: center; justify-content: center;
+  gap: 18px; margin: 12px 0 2px; flex-wrap: wrap;
+}
+.nb-brief-ask {
+  background: var(--coral); color: var(--ink);
+  border: none; border-radius: 999px; cursor: pointer;
+  font-family: 'Nunito', sans-serif; font-weight: 900; font-size: 16px;
+  padding: 13px 26px; min-height: 48px;
+}
+.nb-brief-ask:focus-visible,
+.nb-brief-textbtn:focus-visible,
+.nb-brief-rowhead:focus-visible {
+  outline: 3px solid var(--ink); outline-offset: 2px;
+}
+.nb-brief-textbtn {
+  background: none; border: none; cursor: pointer; padding: 6px 2px;
+  font-family: 'Nunito', sans-serif; font-size: 14px; font-weight: 900;
+  color: var(--ink);
+  border-bottom: 2px solid var(--coral);
+}
+
+/* — Welcome strip (new members, inside the brief) — */
+.nb-brief-welcome {
+  margin-top: 16px; border-top: 1px solid var(--rule);
+  border-bottom: 1px solid var(--rule); padding: 12px 0;
+}
+.nb-brief-faces { display: flex; gap: 14px; margin-top: 8px; flex-wrap: wrap; }
+.nb-brief-face { text-align: center; width: 52px; }
+.nb-brief-face img, .nb-brief-face .nb-brief-face-fallback {
+  width: 44px; height: 44px; border-radius: 50%; object-fit: cover;
+  display: inline-flex; align-items: center; justify-content: center;
+  background: var(--ink); color: var(--paper); font-weight: 900; font-size: 17px;
+}
+.nb-brief-face-name { font-size: 11.5px; font-weight: 800; color: var(--ink-soft); margin-top: 3px; }
+
+/* — Section headers — */
+.nb-brief-section { margin-top: 30px; }
+.nb-brief-section-head {
+  display: flex; align-items: baseline; gap: 12px;
+  border-bottom: 2px solid var(--rule-strong); padding-bottom: 6px;
+}
+.nb-brief-section-title {
+  font-size: 12px; font-weight: 900; letter-spacing: 0.18em;
+  text-transform: uppercase;
+}
+.nb-brief-section-note { font-size: 12.5px; color: var(--ink-faint); font-weight: 700; }
+
+/* — The Lede — */
+.nb-brief-lede { margin-top: 20px; }
+.nb-brief-lede-kicker {
+  font-size: 11px; font-weight: 900; letter-spacing: 0.22em;
+  text-transform: uppercase; color: var(--coral-deep); margin-bottom: 6px;
+}
+.nb-brief-lede-title {
+  font-family: 'Fraunces', Georgia, serif; font-weight: 900;
+  font-size: 25px; line-height: 1.12; letter-spacing: -0.005em;
+}
+.nb-brief-lede-body { font-size: 15.5px; line-height: 1.55; margin-top: 8px; }
+.nb-brief-lede-meta { margin-top: 10px; font-size: 13px; font-weight: 800; color: var(--ink-soft); }
+.nb-brief-lede-actions { margin-top: 10px; display: flex; gap: 20px; align-items: center; }
+
+/* — Index rows (asks) — */
+.nb-brief-row { border-bottom: 1px solid var(--rule); }
+.nb-brief-rowhead {
+  width: 100%; background: none; border: none; cursor: pointer;
+  text-align: left; padding: 14px 0 12px; display: block;
+  font-family: 'Nunito', sans-serif; color: var(--ink);
+}
+.nb-brief-row-title { font-size: 16.5px; font-weight: 900; line-height: 1.3; }
+.nb-brief-row-body {
+  font-size: 14.5px; line-height: 1.45; color: var(--ink-soft);
+  margin-top: 3px; display: -webkit-box; -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical; overflow: hidden;
+}
+.nb-brief-row-meta {
+  margin-top: 7px; font-size: 12.5px; font-weight: 800; color: var(--ink-faint);
+  display: flex; gap: 8px; align-items: center; flex-wrap: wrap;
+}
+.nb-brief-help {
+  background: none; border: none; cursor: pointer; padding: 2px 0;
+  font-family: 'Nunito', sans-serif; font-size: 14px; font-weight: 900;
+  color: var(--coral-deep);
+  border-bottom: 2px solid var(--coral);
+}
+.nb-brief-offered { font-size: 13.5px; font-weight: 900; color: var(--teal); }
+.nb-brief-waiting { color: var(--coral-deep); font-weight: 900; }
+
+/* — Expansion well: the working machinery sits on the navy board — */
+.nb-brief-well {
+  background: var(--well); border-radius: 14px;
+  padding: 10px; margin: 4px 0 16px;
+  transition: opacity 150ms ease;
+}
+.nb-brief-well .nb-card { margin: 0; }
+
+/* — Kindness: pull-quote + compact lines — */
+.nb-brief-quote { padding: 16px 0 4px; }
+.nb-brief-quote-text {
+  font-family: 'Fraunces', Georgia, serif; font-style: italic; font-weight: 600;
+  font-size: 21px; line-height: 1.35;
+}
+.nb-brief-quote-attr { margin-top: 8px; font-size: 13px; font-weight: 800; color: var(--ink-soft); }
+.nb-brief-quote-attr strong { color: var(--ink); font-weight: 900; }
+.nb-brief-line {
+  padding: 10px 0; border-bottom: 1px solid var(--rule);
+  font-size: 14px; line-height: 1.45;
+}
+.nb-brief-line strong { font-weight: 900; }
+.nb-brief-line .nb-brief-line-msg { color: var(--ink-soft); }
+
+/* — Recommendations: a directory — */
+.nb-brief-dir-row { padding: 11px 0; border-bottom: 1px solid var(--rule); }
+.nb-brief-dir-title { font-size: 15.5px; font-weight: 900; }
+.nb-brief-dir-meta { font-size: 12.5px; font-weight: 800; color: var(--ink-faint); margin-top: 2px; }
+
+/* — Empty / quiet states — */
+.nb-brief-empty { margin-top: 26px; text-align: left; }
+.nb-brief-empty-title {
+  font-family: 'Fraunces', Georgia, serif; font-weight: 900;
+  font-size: 24px; line-height: 1.15;
+}
+.nb-brief-empty-body { font-size: 15.5px; line-height: 1.55; margin-top: 8px; color: var(--ink); }
+
+/* — Colophon — */
+.nb-brief-colophon {
+  margin-top: 36px; border-top: 3px solid var(--rule-strong);
+  padding-top: 12px; text-align: center;
+}
+.nb-brief-colophon-main { font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 17px; }
+.nb-brief-colophon-sub { font-size: 12.5px; font-weight: 700; color: var(--ink-faint); margin-top: 4px; }
+.nb-brief-classic {
+  margin-top: 14px; background: none; border: none; cursor: pointer;
+  font-family: 'Nunito', sans-serif; font-size: 12.5px; font-weight: 800;
+  color: var(--ink-faint); text-decoration: underline; text-underline-offset: 3px;
+}
